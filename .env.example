# HTTP port
PORT=3000

# Platform bot from @BotFather (@linza_app_bot or @getlinza_bot)
BOT_TOKEN=
BOT_USERNAME=linza_app_bot
# Short name of the Mini App created with /newapp -> t.me/linza_app_bot/app
WEBAPP_SHORT_NAME=app
# Public HTTPS address of this server (used for the bot menu button)
WEBAPP_URL=https://linza.example.com

# Bot updates: webhook in production, long polling locally
BOT_WEBHOOK_URL=https://linza.example.com/bot/webhook
BOT_WEBHOOK_SECRET=change-me-to-a-long-random-string
BOT_POLLING=0

# Telegram IDs of administrators, comma separated
ADMIN_IDS=100001

# Storage
DB_PATH=./data/linza.db
UPLOADS_DIR=./data/uploads

# Local development only: accept "Authorization: dev <id>" without Telegram
ALLOW_DEV_AUTH=0

# Monthly top auto-publication on the 1st (Moscow time) if no admin has published it
TOP_AUTOPUBLISH_HOUR_MSK=12
