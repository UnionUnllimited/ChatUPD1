# HTTP port
PORT=3000

# Platform bot from @BotFather (@linza_app_bot or @getlinza_bot)
BOT_TOKEN=
BOT_USERNAME=linza_app_bot
# Short name of the Mini App created with /newapp -> t.me/linza_app_bot/app
WEBAPP_SHORT_NAME=app
# Public HTTPS address of the app (a tunnel URL when running from your PC).
# On start the server points the bot's menu button here.
WEBAPP_URL=

# Bot updates: long polling works from any PC without a public address.
BOT_POLLING=1
# Production: set the webhook URL and a long random secret, and BOT_POLLING=0
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Telegram IDs of administrators, comma separated (find yours via @userinfobot)
ADMIN_IDS=100001

# Storage
DB_PATH=./data/linza.db
UPLOADS_DIR=./data/uploads

# Local browser preview only: accept "Authorization: dev <id>" without Telegram.
# Never enable it on a public URL — anyone could sign in as any user.
ALLOW_DEV_AUTH=0

# Monthly top auto-publication on the 1st (Moscow time) if no admin has published it
TOP_AUTOPUBLISH_HOUR_MSK=12
